# General Settings
# ------------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=django-insecure-dummy-key-change-this-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,trashport.shop
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001,https://trashport.shop
DJANGO_READ_DOT_ENV_FILE=True

# Database Configuration (PostgreSQL 16 recommended)
# ------------------------------------------------------------------------------
DATABASE_URL=postgres://debug:debug@127.0.0.1:5432/trashport
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=trashport
POSTGRES_USER=debug
POSTGRES_PASSWORD=debug

# Redis Cache & WebSockets Channel Layer
# ------------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0

# Firebase Authentication & Admin SDK
# ------------------------------------------------------------------------------
# Get your Web API Key from Firebase Console > Project Settings > General
DJANGO_FIREBASE_WEB_API_KEY=AIzaSyYourFirebaseWebApiKeyHere
# Path to your Firebase service account private key (relative to project root)
DJANGO_FIREBASE_CREDENTIALS=serviceAccountKey.json

# Google OAuth 2.0 (PKCE)
# ------------------------------------------------------------------------------
# Create an OAuth 2.0 Web Client in Google Cloud Console Credentials
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-your-google-client-secret

# Email & SMTP (Google App Password)
# ------------------------------------------------------------------------------
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_HOST_USER=your-email@gmail.com
DJANGO_EMAIL_HOST_PASSWORD=your-16-char-app-password
DJANGO_DEFAULT_FROM_EMAIL=TrashPort <noreply@trashport.com>
DJANGO_SERVER_EMAIL=TrashPort <noreply@trashport.com>

# Payments (Stripe / Mock Provider)
# ------------------------------------------------------------------------------
STRIPE_PUBLIC_KEY=pk_test_sample_stripe_public_key
STRIPE_SECRET_KEY=sk_test_sample_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_sample_stripe_webhook_secret

# AI Assistant & Chatbot (Groq Cloud API)
# ------------------------------------------------------------------------------
# Generate your free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
CHATBOT_MODEL=llama-3.1-8b-instant
CHATBOT_MAX_TOKENS=400
CHATBOT_MAX_HISTORY=10

# Celery Broker & Result Backend
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Simulated Aadhaar Mode (Collector Onboarding Demo)
# ------------------------------------------------------------------------------
AADHAAR_MODE=demo
