# General Settings
# ------------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-this-in-production-use-a-strong-random-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_READ_DOT_ENV_FILE=True

# Database (PostgreSQL for prod, SQLite for local dev)
# ------------------------------------------------------------------------------
# DATABASE_URL=postgres://debug:debug@localhost:5432/trashport
DATABASE_URL=sqlite:///db.sqlite3

# Firebase Authentication & Admin SDK
# ------------------------------------------------------------------------------
DJANGO_FIREBASE_WEB_API_KEY=AIzaSyAqb3_F6yPT1gW8LUSzukS6P5Y0qVFzYiE
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id_here
DJANGO_FIREBASE_CREDENTIALS=serviceAccountKey.json

# Payments (Stripe)
# ------------------------------------------------------------------------------
STRIPE_PUBLIC_KEY=pk_test_sample
STRIPE_SECRET_KEY=sk_test_sample
STRIPE_WEBHOOK_SECRET=whsec_sample

# Maps & Geolocation
# ------------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=AIzaSySampleGoogleMapsKey

# Chatbot & LLM
# ------------------------------------------------------------------------------
GEMINI_API_KEY=sample_gemini_api_key
OPENAI_API_KEY=sample_openai_api_key
GROQ_API_KEY=your_groq_api_key_here
CHATBOT_MODEL=llama-3.1-8b-instant
CHATBOT_MAX_TOKENS=400
CHATBOT_MAX_HISTORY=10

# Celery & Redis (Optional / Async Notifications)
