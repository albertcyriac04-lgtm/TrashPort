{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Django (SQLite local)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": [
                "runserver"
            ],
            "django": true,
            "autoReload": {
                "enable": true
            },
            "env": {
                "DJANGO_READ_DOT_ENV_FILE": "True",
                "DATABASE_URL": "sqlite:///db.sqlite3",
                "DJANGO_DEBUG": "True"
            },
            "console": "integratedTerminal"
        },
        {
            "name": "Django (Postgres via Docker)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": [
                "runserver"
            ],
            "django": true,
            "autoReload": {
                "enable": true
            },
            "env": {
                "DJANGO_READ_DOT_ENV_FILE": "True",
                "POSTGRES_HOST": "127.0.0.1",
                "POSTGRES_PORT": "5432",
                "POSTGRES_DB": "trashport",
                "POSTGRES_USER": "debug",
                "POSTGRES_PASSWORD": "debug",
                "DJANGO_DEBUG": "True"
            },
            "console": "integratedTerminal"
        }
    ]
}
